# Database (SQLite by default for zero-friction local execution, or PostgreSQL URL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/lmidb?schema=public"

# Authentication Secret (JWT signing)
AUTH_SECRET="change-this-to-a-secure-random-string-in-production-min-32-chars"

# AI Provider Configuration
# Supported providers: "local" (default deterministic NLP/Taxonomy rule engine), "gemini", "openai", "mock"
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Application Settings
NEXT_PUBLIC_APP_NAME="KaushalyaSetu - Labour Market Intelligence & Curriculum Alignment Platform"
NEXT_PUBLIC_APP_TAGLINE="Transforming Labour Market Signals into Evidence-Based Training & Placement"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
